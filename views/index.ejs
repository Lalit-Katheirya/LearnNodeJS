<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>LearnNodeJS Authentication</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
  <style>
    body {
      min-height: 100vh;
      background: linear-gradient(135deg, #eef2ff 0%, #f8fafc 100%);
      color: #1f2937;
    }
    .hero {
      min-height: 80vh;
      display: grid;
      place-items: center;
      padding: 4rem 1rem;
    }
    .hero-card {
      max-width: 1000px;
      width: 100%;
      background: rgba(255, 255, 255, 0.92);
      border-radius: 1.5rem;
      box-shadow: 0 36px 80px rgba(15, 23, 42, 0.08);
      border: 1px solid rgba(148, 163, 184, 0.18);
      overflow: hidden;
    }
    .hero-card .hero-panel {
      padding: 3rem;
    }
    .hero-card .hero-visual {
      background: radial-gradient(circle at top left, rgba(59, 130, 246, 0.18), transparent 35%),
                  linear-gradient(180deg, #2563eb 0%, #3b82f6 100%);
    }
    .hero-card .hero-visual img {
      max-width: 100%;
      display: block;
      margin: 0 auto;
    }
    .feature-card {
      border-radius: 1rem;
      border: 1px solid rgba(148, 163, 184, 0.18);
      background: #ffffff;
      transition: transform 0.2s ease, box-shadow 0.2s ease;
    }
    .feature-card:hover {
      transform: translateY(-3px);
      box-shadow: 0 24px 50px rgba(15, 23, 42, 0.08);
    }
    @media (max-width: 991px) {
      .hero-card {
        grid-template-columns: 1fr;
      }
      .hero-card .hero-visual {
        padding: 2rem 1.5rem;
      }
    }
  </style>
</head>
<body>
  <nav class="navbar navbar-expand-lg navbar-light bg-white border-bottom shadow-sm">
    <div class="container">
      <a class="navbar-brand fw-bold text-primary" href="/">LearnNodeJS</a>
      <div>
        <a href="/register" class="btn btn-outline-primary me-2">Register</a>
        <a href="/login" class="btn btn-primary">Login</a>
      </div>
    </div>
  </nav>

  <section class="hero">
    <div class="hero-card d-lg-flex">
      <div class="hero-panel">
        <span class="badge rounded-pill bg-primary bg-opacity-10 text-primary mb-3">Modern Node.js Auth</span>
        <h1 class="display-5 fw-bold mb-3">Secure authentication made simple.</h1>
        <p class="lead text-muted mb-4">Build your login and registration flow with clean EJS views, JWT support, and a responsive UI designed for modern web apps.</p>
        <div class="d-flex flex-wrap gap-3">
          <a href="/register" class="btn btn-primary btn-lg">Create account</a>
          <a href="/login" class="btn btn-outline-secondary btn-lg">Sign in</a>
        </div>
      </div>
      <div class="hero-visual d-flex align-items-center justify-content-center p-5 text-white">
        <div class="text-center">
          <h2 class="h3 text-white mb-3">Fast, secure access</h2>
          <p class="mb-4 opacity-75">Responsive forms, instant validation, and a clear path from landing page to login.</p>
          <img src="https://images.unsplash.com/photo-1517245386807-bb43f82c33c4?auto=format&fit=crop&w=700&q=80" alt="Modern dashboard" loading="lazy" style="border-radius: 1rem;" />
        </div>
      </div>
    </div>
  </section>

  <section class="container pb-5">
    <div class="row g-4">
      <div class="col-md-4">
        <div class="feature-card p-4 h-100">
          <h3 class="h5 fw-semibold">Responsive UI</h3>
          <p class="text-muted mb-0">Mobile-first layout with Bootstrap and clean form design across devices.</p>
        </div>
      </div>
      <div class="col-md-4">
        <div class="feature-card p-4 h-100">
          <h3 class="h5 fw-semibold">Easy routing</h3>
          <p class="text-muted mb-0">Separate web views and API routes for organization and scalability.</p>
        </div>
      </div>
      <div class="col-md-4">
        <div class="feature-card p-4 h-100">
          <h3 class="h5 fw-semibold">JWT-ready</h3>
          <p class="text-muted mb-0">A modern auth flow ready for tokens, sessions, and protected pages.</p>
        </div>
      </div>
    </div>
  </section>
</body>
</html>
